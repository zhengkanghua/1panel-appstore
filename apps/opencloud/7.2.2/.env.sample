# OpenCloud - 1Panel 本地应用环境变量
# 手动 docker compose 部署时: cp .env.sample .env 后按需修改

# 容器名称
CONTAINER_NAME="opencloud"

# 宿主机映射端口 (容器内固定 9200)
PANEL_APP_PORT_HTTP="9200"

# 访问地址, 必须为 https 且与浏览器地址一致
# 直连模式:   https://<服务器IP>:9200
# 反向代理模式: https://cloud.example.com
OC_URL="https://localhost:9200"

# 管理员密码 (仅首次启动生效, 之后只能在 OpenCloud 界面或 CLI 中修改)
INITIAL_ADMIN_PASSWORD=""

# 内置自签名 HTTPS
# true  = OpenCloud 直接以自签名证书提供 https (直连访问)
# false = 纯 http, 需配合前置反向代理做 TLS 终止
PROXY_TLS="true"

# 跳过证书验证 (自签名证书场景必须为 true)
INSECURE="true"

# 配置目录与数据目录 (注意目录属主需为 1000:1000)
OC_CONFIG_DIR="./data/config"
OC_DATA_DIR="./data/storage"

# 时区
TIME_ZONE="Asia/Shanghai"

# 默认语言 (ISO 639-1, 如 en, de, zh)
DEFAULT_LANGUAGE="en"

# 为不支持 OpenID Connect 的 WebDAV 客户端启用 Basic Auth (不推荐)
PROXY_ENABLE_BASIC_AUTH="false"

# ---------- 以下为可选高级配置 ----------

# 容器运行用户 UID:GID
OC_CONTAINER_UID_GID="1000:1000"

# 日志级别 (error, warn, info, debug) 与人类可读日志
LOG_LEVEL="info"
LOG_PRETTY="false"

# Docker 日志驱动 (与官方一致, local 自带轮转防止日志占满磁盘)
LOG_DRIVER="local"

# Web 扩展目录 (放入扩展后重启容器生效)
OC_APPS_DIR="./data/apps"

# 创建演示用户 (alan, mary, margaret, dennis, lynn, 密码均为 demo, 生产环境勿开)
DEMO_USERS="false"

# 额外启动的服务, 逗号分隔 (如 "notifications,antivirus")
START_ADDITIONAL_SERVICES=""

# 客户端检查更新
CHECK_FOR_UPDATES="true"

# SMTP 邮件通知 (需同时把 notifications 加入 START_ADDITIONAL_SERVICES)
SMTP_HOST=""
SMTP_PORT=""
SMTP_SENDER=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_AUTHENTICATION=""
SMTP_TRANSPORT_ENCRYPTION=""
SMTP_INSECURE="false"

# 密码策略
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD="true"
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD="false"
OC_PASSWORD_POLICY_DISABLED="false"
OC_PASSWORD_POLICY_MIN_CHARACTERS="8"
OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS="1"
OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS="1"
OC_PASSWORD_POLICY_MIN_DIGITS="1"
OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS="1"
