# 上游同步记录 —— 升级时据此判断上游配置是否有变更, 流程见 docs/UPGRADE.md
# 每次完成同步后, 更新 last_synced_commit 和 last_synced_date
repo: https://github.com/opencloud-eu/opencloud-compose
last_synced_commit: 213dde31c83c2803cfe0b32ad53f1aba87322618
last_synced_date: 2026-07-30
# 7.2.2 保留生产发布线; 7.3.0/latest 跟随官方 Compose 的固定 rolling 标签
image: opencloudeu/opencloud
rolling_image: opencloudeu/opencloud-rolling
# 升级时需要关注 diff 的上游文件
watched_files:
  - docker-compose.yml
  - .env.example
  - external-proxy/opencloud.yml
  - storage/decomposeds3.yml
  - config/opencloud/csp.yaml
  - config/opencloud/banned-password-list.txt
