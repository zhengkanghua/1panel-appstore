# OpenCloud - 1Panel local app environment variables
# For manual Compose deployment: copy this file to .env and adjust it.

CONTAINER_NAME="opencloud"

# Public URL. It must use HTTPS and exactly match the browser URL.
OC_URL="https://cloud.example.com"

# 1Panel reverse proxy (recommended): bind 127.0.0.1 and disable built-in TLS.
# Direct HTTPS: bind 0.0.0.0, enable built-in TLS, and set INSECURE=true.
PANEL_APP_PORT_HTTP="9200"
PANEL_APP_BIND_IP="127.0.0.1"
PROXY_TLS="false"
INSECURE="false"

# Only effective on the first start.
INITIAL_ADMIN_PASSWORD=""

# Container identity and persistent directories.
OC_CONTAINER_UID_GID="1000:1000"
OC_CONFIG_DIR="./data/config"
OC_DATA_DIR="./data/storage"
OC_APPS_DIR="./data/apps"

# Primary user storage. Keep decomposed for local storage or select
# decomposeds3 and configure all S3 values before the first start.
STORAGE_USERS_DRIVER="decomposed"
DECOMPOSEDS3_ENDPOINT=""
DECOMPOSEDS3_REGION="default"
DECOMPOSEDS3_ACCESS_KEY=""
DECOMPOSEDS3_SECRET_KEY=""
DECOMPOSEDS3_BUCKET=""
DECOMPOSEDS3_EVENTS_NUM_CONSUMERS="5"

TIME_ZONE="Asia/Shanghai"
DEFAULT_LANGUAGE="en"
DEMO_USERS="false"
PROXY_ENABLE_BASIC_AUTH="false"
CHECK_FOR_UPDATES="true"
FRONTEND_ARCHIVER_MAX_SIZE="10000000000"

# Comma-separated built-in services. Use "notifications" for email.
START_ADDITIONAL_SERVICES=""

LOG_LEVEL="info"
LOG_PRETTY="false"
LOG_DRIVER="local"

# SMTP settings. Add notifications to START_ADDITIONAL_SERVICES to use these.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SENDER=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_AUTHENTICATION="auto"
SMTP_TRANSPORT_ENCRYPTION="none"
SMTP_INSECURE="false"

# Sharing and password policy defaults from the official Compose project.
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD="true"
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD="false"
OC_PASSWORD_POLICY_DISABLED="false"
OC_PASSWORD_POLICY_MIN_CHARACTERS="8"
OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS="1"
OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS="1"
OC_PASSWORD_POLICY_MIN_DIGITS="1"
OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS="1"
