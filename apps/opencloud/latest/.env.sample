# OpenCloud 1Panel App - Environment Variables

# HTTP Port for web interface (internal OpenCloud port is 9200)
PANEL_APP_PORT_HTTP=8080

# Domain (optional, for production use with reverse proxy)
# e.g. cloud.example.com
OC_DOMAIN=

# Admin password (required, set on first run only - cannot be changed later via env)
INITIAL_ADMIN_PASSWORD=

# Skip certificate validation (true for self-signed certs)
INSECURE=true

# Container UID:GID (default 1000:1000)
OC_CONTAINER_UID_GID=1000:1000

# Config folder path (OpenCloud will generate init configuration here on first run)
OC_CONFIG_DIR=./data/config

# Data folder path
OC_DATA_DIR=./data/storage

# Time zone
TIME_ZONE=Asia/Shanghai

# Default language (ISO 639-1, e.g. en, de, fr, zh)
DEFAULT_LANGUAGE=en

# Enable basic auth for WebDAV clients (not recommended, but needed for some clients)
PROXY_ENABLE_BASIC_AUTH=false

# Enable demo users (alan, mary, margaret, dennis, lynn - password: demo)
DEMO_USERS=false

# Pretty logging (human-readable output)
LOG_PRETTY=false

# Log level (info, debug, warn, error)
LOG_LEVEL=info

# Additional services to start (comma separated, e.g. "notifications,antivirus")
START_ADDITIONAL_SERVICES=

# Email/SMTP settings (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_TRANSPORT_ENCRYPTION=
SMTP_INSECURE=false

# Check for updates
CHECK_FOR_UPDATES=true

# Password policy settings
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=true
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=false
OC_PASSWORD_POLICY_DISABLED=false
OC_PASSWORD_POLICY_MIN_CHARACTERS=8
OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_DIGITS=1
OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS=1
