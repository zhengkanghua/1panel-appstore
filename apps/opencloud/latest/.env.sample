# OpenCloud Environment Variables

# HTTP Port for web interface
PANEL_APP_PORT_HTTP=8080

# Domain (optional, for production use with reverse proxy)
OC_DOMAIN=

# Admin password (required, set on first run only)
INITIAL_ADMIN_PASSWORD=admin

# Config folder path
OC_CONFIG_PATH=./data/config

# Data folder path
OC_DATA_PATH=./data/storage

# Time zone
TIME_ZONE=Asia/Shanghai

# Skip certificate validation (true for self-signed certs)
INSECURE=true
